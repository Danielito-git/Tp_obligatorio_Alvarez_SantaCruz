<%# Panel con los productos de la base separados por tipo, con las acciones de modificar, desactivar, reactivar y eliminar; lo muestra panelControlador.js en /admin/dashboard. %>
<%- include('parciales/encabezado', { titulo: 'Dashboard' }) %>

  <main class="panel">
    <div class="panelCabecera">
      <h1>Panel de administrador</h1>
      <a class="boton botonPrimario" href="/admin/productos/nuevo">
        <span class="icono iconoMas" aria-hidden="true"></span>
        <span class="botonTexto">Agregar producto</span>
      </a>
    </div>

    <% secciones.forEach((seccion) => { %>
    <section class="panelSeccion">
      <h2>
        <span class="icono <%= seccion.icono %>" aria-hidden="true"></span>
        <%= seccion.nombre %>
        <span class="panelCantidad">(<%= seccion.productos.length %>)</span>
      </h2>

      <% if (seccion.productos.length === 0) { %>
      <p class="estado">No hay productos de este tipo.</p>
      <% } else { %>
      <div class="tablaContenedor">
        <table class="tablaPanel">
          <thead>
            <tr>
              <th>ID</th><th>Imagen</th><th>Nombre</th><th class="columnaNumero">Precio</th><th>Estado</th><th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% seccion.productos.forEach((producto) => { %>
            <tr class="<%= producto.activo ? '' : 'filaInactiva' %>">
              <td><%= producto.id %></td>
              <td><img src="/<%= producto.imagen %>" alt="" class="tablaImagen" width="48" height="48"></td>
              <td><%= producto.nombre %></td>
              <td class="columnaNumero"><%= formatearPrecio(producto.precio) %></td>
              <td>
                <span class="etiqueta <%= producto.activo ? 'etiquetaActivo' : 'etiquetaInactivo' %>"><%= producto.activo ? 'Activo' : 'Inactivo' %></span>
              </td>
              <td>
                <div class="tablaAcciones">
                  <a class="boton botonChico" href="/admin/productos/<%= producto.id %>/editar">Modificar</a>
                  <% if (producto.activo) { %>
                  <button type="button" class="boton botonChico botonPeligro" data-accion="desactivar" data-id="<%= producto.id %>" data-nombre="<%= producto.nombre %>">Desactivar</button>
                  <% } else { %>
                  <button type="button" class="boton botonChico" data-accion="reactivar" data-id="<%= producto.id %>" data-nombre="<%= producto.nombre %>">Reactivar</button>
                  <% } %>
                  <button type="button" class="boton botonChico botonPeligro" data-accion="eliminar" data-id="<%= producto.id %>" data-nombre="<%= producto.nombre %>">Eliminar</button>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
    <% }) %>
  </main>

  <%# Modal de confirmacion: lo comparten las tres acciones; publico/js/dashboard.js completa su texto según la acción elegida. %>
  <dialog id="dialogoConfirmar" class="dialogo" aria-labelledby="dialogoTitulo">
    <h2 id="dialogoTitulo"></h2>
    <p id="dialogoTexto"></p>
    <p id="dialogoError" class="mensajeError" role="alert" hidden></p>
    <div class="dialogoAcciones">
      <button type="button" id="dialogoCancelar" class="boton">Cancelar</button>
      <button type="button" id="dialogoConfirmarBoton" class="boton botonPrimario"></button>
    </div>
  </dialog>

  <script src="/js/dashboard.js"></script>

<%- include('parciales/pie') %>
